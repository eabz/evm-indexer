# Copy this file to `.env` and adjust the values.
#
#   - `docker compose` reads it for the ClickHouse credentials and passes every
#     uncommented variable to the indexer container.
#   - The indexer binary reads the same variables when run outside of Docker
#     (each one is equivalent to the CLI flag named next to it).
#
# Leave optional variables commented out rather than empty.

# ---------------------------------------------------------------------------
# ClickHouse container (docker compose only)
# ---------------------------------------------------------------------------
# Keep CLICKHOUSE_DB=indexer: the SQL in ./migrations creates its tables in the
# `indexer` database.
CLICKHOUSE_DB=indexer
CLICKHOUSE_USER=indexer
# URL-encode special characters, the password ends up inside DATABASE_URL.
CLICKHOUSE_PASSWORD=indexer

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# --hypersync-token  Envio HyperSync API token.
# Get one at https://docs.envio.dev/docs/HyperSync/api-tokens
ENVIO_API_TOKEN=

# --database  ClickHouse HTTP endpoint: http(s)://user:password@host:port/database
# Always include the port (8123 for plain HTTP, 8443 for ClickHouse Cloud).
# Not the native protocol: port 9000 / 9440 will not work.
# docker compose overrides this to point at the bundled `clickhouse` service.
DATABASE_URL=http://indexer:indexer@localhost:8123/indexer

# ---------------------------------------------------------------------------
# Chain and block range
# ---------------------------------------------------------------------------
# --chain  Chain ID to index. Default: 1 (Ethereum mainnet).
CHAIN_ID=1

# --hypersync-url  HyperSync endpoint. Default: derived from the chain ID.
# Only needed for networks that cannot be derived or for a custom endpoint.
#HYPERSYNC_URL=https://eth.hypersync.xyz

# --start-block  First block to index. Default: 0.
START_BLOCK=0

# --end-block  Block to stop at, EXCLUSIVE: END_BLOCK=100 indexes up to block
# 99 and exits. Default: 0 = follow the chain head.
END_BLOCK=0

# --confirmations  Stay this many blocks behind the chain head so blocks that
# can still be reorged are not indexed (reorgs are only detected, never
# repaired). Use the chain's typical reorg depth, e.g. 12-64 on Ethereum-like
# chains, 0 on instant-finality chains. Default: 0 = index up to the head.
CONFIRMATIONS=0

# --new-blocks-only  Skip the historical backfill, only index new blocks.
NEW_BLOCKS_ONLY=false

# --traces  Index transaction traces. Default: false.
# Only works on HyperSync networks that serve trace data.
TRACES=false

# ---------------------------------------------------------------------------
# Token metadata (optional)
# ---------------------------------------------------------------------------
# --rpc  JSON-RPC endpoint, used ONLY for token metadata eth_calls
# (name / symbol / decimals through Multicall3). Without it, token metadata is
# skipped.
#RPC_URL=https://your-rpc-endpoint.example

# --redis  Redis or Dragonfly URL used to cache token metadata. Without it an
# in-memory cache is used. docker compose overrides this to point at the
# bundled `dragonfly` service.
#REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Writer tuning
# ---------------------------------------------------------------------------
# --flush-rows  Flush to ClickHouse once this many rows are buffered. Default: 100000.
FLUSH_ROWS=100000

# --flush-interval-ms  Flush at least this often, in milliseconds. Default: 2000.
FLUSH_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# --debug  Enable debug logging.
DEBUG=false
