# Copy this file to `.env` and adjust the values. `.env` is git-ignored; this
# template contains no secrets and must not be given any.
#
#   - `docker compose` reads it for the ClickHouse credentials and the host
#     ports, and passes every uncommented variable to the indexer container(s).
#   - The indexer binary reads the same variables when run outside of Docker
#     (each one is equivalent to the CLI flag named next to it).
#
# Leave optional variables commented out rather than empty. A blank value
# (`VAR=`) is treated exactly like an unset one.
#
# ONLY TWO VALUES HAVE NO DEFAULT: ENVIO_API_TOKEN and ADMIN_PASSWORD.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# --hypersync-token  Envio HyperSync API token. One token serves every chain.
# Get one at https://docs.envio.dev/docs/HyperSync/api-tokens
ENVIO_API_TOKEN=

# ADMIN_PASSWORD  The control panel's password (`indexer fleet` only). Read
# ONLY from the environment, never from a command line flag: a flag is visible
# to every user on the host through `ps`. While this is unset the panel is off
# and its port is not bound.
#
# MINIMUM 12 CHARACTERS, and not one character repeated twelve times, and not
# one of the handful of phrases on the built-in denylist. Anything else is
# refused and the panel stays off, with the reason in the log: it can start and
# stop the indexing of every chain in the process, and five guesses a minute is
# enough to walk a PIN or a short word.
#
# Generate one with:
#
#   openssl rand -base64 18
#
# A passphrase of a few words you have not seen anywhere else is fine too.
ADMIN_PASSWORD=

# --database  ClickHouse HTTP endpoint: http(s)://user:password@host:port/database
# Always include the port (8123 for plain HTTP, 8443 for ClickHouse Cloud).
# Not the native protocol: port 9000 / 9440 will not work.
# The database is created when it does not exist, and pending schema migrations
# are applied at startup (see NO_MIGRATE).
# docker compose overrides this to point at the bundled `clickhouse` service.
DATABASE_URL=http://indexer:indexer@localhost:8123/indexer

# ---------------------------------------------------------------------------
# ClickHouse container and host ports (docker compose only)
# ---------------------------------------------------------------------------
# Account created in the bundled ClickHouse container.
CLICKHOUSE_USER=indexer
# URL-encode special characters, the password ends up inside DATABASE_URL.
CLICKHOUSE_PASSWORD=indexer
# Database name used in the DATABASE_URL that compose hands to the indexer.
# Any name works: the indexer creates the database and its tables itself.
# All chains share this one database.
CLICKHOUSE_DB=indexer

# Host port (127.0.0.1) for the Prometheus endpoint. Default: 9101.
#METRICS_PORT=9101

# Host port (127.0.0.1) for the control panel of `indexer fleet`. The panel
# speaks plain HTTP; reach it from elsewhere through an SSH tunnel or a TLS
# reverse proxy (see the README). Default: 8090.
#ADMIN_PORT=8090

# ---------------------------------------------------------------------------
# Fleet mode (`indexer fleet`)
# ---------------------------------------------------------------------------
# The per-chain settings of a fleet come from the `fleet_chains` table and the
# control panel, NOT from this file: CHAIN_ID, START_BLOCK, CONFIRMATIONS and
# the rest below are read by `indexer run` and ignored by `indexer fleet`.
#
# Which chains a fresh database starts with is the `--chain` list in the
# `fleet` service's `command:` in docker-compose.yml. There is no environment
# variable for it, and none for the --admin-host / --admin-trusted-proxy /
# --admin-allow-remote / --admin-secure-cookie flags either: they are command
# line only.

# --admin-addr  Where the control panel listens. Default 127.0.0.1:8090.
# Anything other than a loopback address is refused unless the fleet is also
# started with --admin-allow-remote (and put behind a TLS reverse proxy).
# docker compose sets it to 0.0.0.0:8090 inside the container.
#ADMIN_ADDR=127.0.0.1:8090

# --fleet-max-inflight-mb  Rough cap, in megabytes, on the rows the WHOLE
# fleet buffers before writing. Split over the chains that are running, so
# one more chain makes every chain's write batches smaller instead of making
# the process bigger. Default: 2048.
#FLEET_MAX_INFLIGHT_MB=2048

# --solana-queries-per-minute  Metered Solana HyperSync queries a minute,
# shared by every Solana chain in the process (the provider meters the
# TOKEN, not the chain). The free tier allows 30. Default: 25.
#SOLANA_QUERIES_PER_MINUTE=25

# ---------------------------------------------------------------------------
# Single chain (`indexer run`): chain and coverage floor
# ---------------------------------------------------------------------------
# --chain  Chain to index. Default: 1 (Ethereum mainnet).
# One indexer process per chain; all of them can share one database.
#
# Also accepts the name `solana` (= 1399811149). On Solana START_BLOCK is a
# SLOT and must be at least 391000000, CONFIRMATIONS and NO_DEX are refused,
# START_DATE is refused, and RPC_URL / REDIS_URL / MAX_REORG_DEPTH /
# NO_PREDICTIONS are ignored with one log line each. See the Solana section of
# the README.
CHAIN_ID=1

# --start-block / --start-date  WHERE THIS CHAIN'S HISTORY BEGINS.
#
# Read on a chain's FIRST start ONLY. Whatever they resolve to is stored as the
# chain's COVERAGE FLOOR and is fixed from then on: a restart, a different
# value here, or the control panel cannot move it. Moving it earlier is
# `indexer backfill --start-block N`; moving it later is refused outright.
#
# START_BLOCK=0 means "not given", which is the default and gives you ONE YEAR
# of history on an EVM chain (the head on Solana). There is no way to ask for
# block 0 itself; use START_DATE with an early date for a deep history.
#
# The two are mutually exclusive - setting both is an error.
#START_BLOCK=0
#START_DATE=2024-01-01

# --new-blocks-only  Skip the historical backfill and start at the head. The
# coverage floor is then the head.
NEW_BLOCKS_ONLY=false

# --end-block  Block to stop at, EXCLUSIVE: END_BLOCK=100 indexes up to block
# 99 and exits. Default: 0 = follow the chain head.
END_BLOCK=0

# --hypersync-url  HyperSync endpoint. Default: derived from the chain ID.
# Only needed for a custom or private endpoint. The indexer asks it which chain
# it serves and refuses to start on a wrong or missing answer. Note that this
# is per PROCESS: a chain that needs its own endpoint needs its own
# `indexer run`, it cannot be one chain of a fleet.
#HYPERSYNC_URL=https://eth.hypersync.xyz

# ---------------------------------------------------------------------------
# Reorgs
# ---------------------------------------------------------------------------
# Reorgs are detected AND repaired automatically (the orphaned blocks are
# tombstoned, the canonical ones are indexed again), see "Reorgs" in README.md.

# --confirmations  Optional head lag: stay this many blocks behind the chain
# head, so most reorgs are never stored in the first place (fewer rollbacks,
# data shows up N blocks later). Default: 0 = index up to the head.
CONFIRMATIONS=0

# --max-reorg-depth  Deepest rollback the indexer performs on its own. A fork
# point further back than this stops the process with an error instead of
# rewriting that much history. Default: 512.
#MAX_REORG_DEPTH=512

# ---------------------------------------------------------------------------
# Schema migrations
# ---------------------------------------------------------------------------
# --no-migrate  Do not apply pending migrations at startup; run
# `indexer migrate` yourself (e.g. once per deploy when running many chains).
# Default: false.
#NO_MIGRATE=false

# ---------------------------------------------------------------------------
# Token metadata and pool resolution (eth_call over JSON-RPC)
# ---------------------------------------------------------------------------
# --rpc  Comma-separated list of JSON-RPC endpoints, used ONLY for eth_calls
# that HyperSync cannot serve: token name / symbol / decimals and the tokens of
# DEX pools first seen mid-history. Never on the commit path: an RPC outage
# delays metadata, it never stops or loses block data.
#
#   auto (DEFAULT, also when unset)  public endpoints for the chain id are
#        discovered at startup from https://chainid.network/chains.json. This
#        is an outbound request to a third party, and public endpoints are
#        best effort (rate limits, no guarantees).
#   https://my-node.example,auto     RECOMMENDED for production: your endpoint
#        first, public endpoints as fallback.
#   https://a.example,https://b.example   your endpoints only, with failover.
#   none                             no RPC at all: no token metadata, so DEX
#        amounts cannot be decimals-adjusted or valued in USD.
#
# TWO PROVIDERS MUST AGREE before a value is written, so ONE endpoint is not
# enough: a chain whose only public endpoint is a single provider resolves no
# metadata on `auto` alone. Give such a chain a real endpoint
# (`https://mine,auto` counts as two).
#RPC_URL=https://your-rpc-endpoint.example,auto

# --redis  Redis or Dragonfly URL used to cache token metadata across restarts.
# Optional: without it an in-memory cache is used. docker compose overrides
# this to point at the bundled `dragonfly` service.
#REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Analytics modules
# ---------------------------------------------------------------------------
# --no-dex  DEX analytics (pools, swaps, liquidity, candles, volume, USD views)
# are ON by default. They are decoded from logs that are fetched anyway, so
# they cost no extra HyperSync traffic. Set to true to turn them off.
#NO_DEX=false

# --no-predictions  Prediction-market analytics are ON by default, like DEX.
# The headline views only count the registry and exchange addresses listed in
# `prediction_trusted`, which is operator data (see src/predictions/README.md).
#NO_PREDICTIONS=false

# --no-launchpads  Token-launchpad analytics are ON by default, like DEX.
# The headline views only count emitters listed in `launchpad_trusted_emitters`,
# which is operator data (see src/launchpads/README.md).
#NO_LAUNCHPADS=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# --metrics-addr  ip:port to serve Prometheus metrics (/metrics) and the
# /healthz and /readyz probes on. Default: off. docker compose sets it to
# 0.0.0.0:9090 inside the container (published on 127.0.0.1:METRICS_PORT).
# Use a different port per indexer process when running several on one host.
# It has NO authentication and no loopback guard, and a bare `:9090` expands to
# 0.0.0.0:9090 - keep it on localhost or a private network.
#METRICS_ADDR=127.0.0.1:9090

# ---------------------------------------------------------------------------
# Writer tuning
# ---------------------------------------------------------------------------
# --flush-rows  Flush to ClickHouse once this many rows are buffered. Default: 100000.
FLUSH_ROWS=100000

# --flush-interval-ms  Flush at least this often, in milliseconds. Default: 2000.
FLUSH_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# --debug  Enable debug logging.
DEBUG=false
